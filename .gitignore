spawn
/spored
/spored.exe
/spawn.exe

# Cross-compiled spored release artifacts (binaries, checksums, tarballs)
spored-linux-*
spored_*.tar.gz

# Lambda build artifacts
lambda/*/bootstrap
lambda/*/function.zip
lambda/*.zip
# Any zip inside a lambda module. `lambda/*.zip` above only matches the lambda/
# directory itself, so the release artifact GoReleaser's before-hook builds
# (lambda/ttl-reaper/ttl-reaper_lambda_linux_arm64.zip, #625) was committable — a
# 25 MiB binary one `git add -A` away from the repo.
lambda/*/*.zip

# Lambda compiled binaries (named after their function)
lambda/alert-evaluator/alert-evaluator
lambda/alert-handler/alert-handler
lambda/autoscale-orchestrator/autoscale-orchestrator
lambda/cost-history-collector/cost-history-collector
lambda/dashboard-api/dashboard-api
lambda/dashboard-websocket/dashboard-websocket
lambda/dashboard-websocket-processor/dashboard-websocket-processor
lambda/dns-updater/dns-updater
lambda/pipeline-orchestrator/pipeline-orchestrator
lambda/scheduler-handler/scheduler-handler
lambda/spore-bot/spore-bot
lambda/spore-bot/prism-bot
lambda/sweep-orchestrator/sweep-orchestrator
lambda/ttl-reaper/ttl-reaper

# …and the same binaries at the REPO ROOT. A single-package
# `go build ./lambda/<name>/` writes the executable into the current directory,
# not next to its source, so the entries above do not cover it. Committing one is
# a 42 MB mistake `git add -A` makes silently: it happened while writing #845 and
# TestNoTrackedCompiledBinaries caught it in CI rather than locally.
#
# TestGitignoreCoversEveryLambdaBinary keeps both lists complete. The first version
# of this one named nine of the twelve directories — the hand-maintained-list
# defect that PR was fixing, reproduced in its own fix.
/alert-evaluator
/alert-handler
/autoscale-orchestrator
/cost-history-collector
/dashboard-api
/dashboard-websocket
/dashboard-websocket-processor
/dns-updater
/pipeline-orchestrator
/scheduler-handler
/sweep-orchestrator
/ttl-reaper

# SAM CodeUri build dirs — hold ONLY bootstrap; see #645
lambda/*/build/

# SAM build dirs
lambda/*/.aws-sam/

# Generated sam deploy parameter files (hold per-deploy values, e.g. webhook URLs)
lambda/*/.deploy-params.yaml

# Build artifacts
bin/
.DS_Store
